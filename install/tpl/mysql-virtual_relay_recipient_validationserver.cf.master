user = {mysql_server_ispconfig_user}
password = {mysql_server_ispconfig_password}
dbname = {mysql_server_database}
hosts = {mysql_server_ip}
query = select validation_server from mail_relay_recipient where active = 'y' and server_id = {server_id} and (source = '%s' or source = CONCAT('@', SUBSTRING_INDEX('%s', '@', -1)))
