# Do not change this file, as changes will be overwritten by any ISPConfig update.
# Put your custom settings in /usr/local/ispconfig/server/conf-custom/install/dovecot_custom.conf.master.
# To start using those changes, do a force upgrade and let it reconfigure your services. (ispconfig_update.sh --force)

dovecot_config_version = 2.4.1
dovecot_storage_version = 2.4.1

listen = *,[::]
# Note: lmtp and sieve protocols are added dynamically by the installer when installed
protocols = imap pop3
auth_mechanisms = plain login
#auth_allow_cleartext = no
log_timestamp = "%Y-%m-%d %H:%M:%S "
mail_privileged_group = vmail
ssl_server_cert_file = /etc/postfix/smtpd.cert
ssl_server_key_file = /etc/postfix/smtpd.key
ssl_server_dh_file = /etc/dovecot/dh.pem
ssl_min_protocol = TLSv1.2
ssl_cipher_list = ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
ssl_server_prefer_ciphers = server
mail_max_userip_connections = 100

#log_debug = category=debug

!include dovecot-sql.conf

passdb sql {
  sql_driver = mysql
  passdb_default_password_scheme = CRYPT
 
  passdb_sql_query = SELECT email as user, password, maildir as userdb_home, CONCAT( maildir_format, ':', maildir, '/', \
		IF(maildir_format='maildir','Maildir',maildir_format)) as userdb_mail, uid as userdb_uid, gid as userdb_gid, \
		CONCAT(quota, 'B') AS userdb_quota_storage_size, CONCAT(maildir, '/.sieve') as userdb_sieve, NULLIF(imap_prefix, '') as "userdb_namespace/inbox/prefix" \
	FROM mail_user \
	WHERE (login = '%{user}' OR email = '%{user}') \
		AND `disable%{protocol | lower}` = 'n' \
		AND server_id = '{server_id}' \
		AND NOT EXISTS (SELECT domain_id FROM mail_domain WHERE domain = '%{user | domain }' AND active = 'n' AND server_id = {server_id})

}
userdb sql {
  sql_driver = mysql

  userdb_sql_query = SELECT email as user, maildir as home, CONCAT( maildir_format, ':', maildir, '/', IF(maildir_format='maildir','Maildir',maildir_format)) as mail, \
		uid, gid, CONCAT(quota, 'B') AS quota_storage_size, CONCAT(maildir, '/.sieve') as sieve, NULLIF(imap_prefix, '') as "namespace/inbox/prefix" \
	FROM mail_user \
	WHERE (login = '%{user}' OR email = '%{user}') \
		AND `disable%{protocol | lower}` = 'n' \
		AND server_id = '{server_id}'

  userdb_sql_iterate_query = SELECT email as user FROM mail_user WHERE disabledoveadm='n' AND server_id = '{server_id}'
}

# Sieve script storages (Dovecot 2.4 syntax)
sieve_script personal {
  path = /var/vmail/%{user | domain}/%{user | username}/.sieve
}
sieve_script ispconfig_before {
  type = before
  path = /var/vmail/%{user | domain}/%{user | username}/.ispconfig-before.sieve
}
sieve_script ispconfig_after {
  type = after
  path = /var/vmail/%{user | domain}/%{user | username}/.ispconfig.sieve
}

# Sieve settings
sieve_max_script_size = 2M
sieve_max_actions = 100
sieve_max_redirects = 25

# Quota configuration (Dovecot 2.4 syntax)
mail_plugins = quota
mailbox_list_index = yes

quota "User quota" {
  driver = count
  # quota_storage_size is set via userdb
}

service auth {
  unix_listener /var/spool/postfix/private/auth {
    group = postfix
    mode = 0660
    user = postfix
  }
  unix_listener auth-userdb {
    group = vmail
    mode = 0600
    user = vmail
  }
  user = root
}
service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
   group = postfix
   mode = 0600
   user = postfix
   # For higher volume sites, it may be desirable to increase the number of active listener processes.
   # A range of 5 to 20 is probably good for most sites
#   process_min_avail = 5
  }
}
lmtp_rcpt_check_quota = yes
service imap-login {
  client_limit = 1000
  process_limit = 512
}
protocol imap {
  mail_plugins = quota imap_quota
  auth_verbose = yes
}
protocol pop3 {
  pop3_uidl_format = %{uid | hex(8)}%{uidvalidity | hex(8)}
  mail_plugins = quota
  auth_verbose = yes
}
protocol lda {
  postmaster_address = postmaster@localhost
  mail_plugins = sieve quota
}
protocol lmtp {
  postmaster_address = postmaster@localhost
  mail_plugins = quota sieve
}

service stats {
    unix_listener stats-reader {
        user = vmail
        group = vmail
        mode = 0660
    }

    unix_listener stats-writer {
        user = vmail
        group = vmail
        mode = 0660
    }
}

service quota-status {
  executable = quota-status -p postfix
  unix_listener /var/spool/postfix/private/quota-status {
    group = postfix
    mode = 0660
    user = postfix
  }
  client_limit = 1
}

# Quota status service settings (global in Dovecot 2.4)
quota_status_success = DUNNO
quota_status_nouser = DUNNO
quota_status_overquota = "552 5.2.2 Mailbox is full"

imap_capability=+SPECIAL-USE XLIST
namespace inbox {
  inbox = yes
  separator = .
  mailbox Drafts {
    special_use = \Drafts
  }
  mailbox Junk {
    special_use = \Junk
  }
  mailbox Sent {
    special_use = \Sent
  }
  mailbox "Sent Messages" {
    special_use = \Sent
  }
  mailbox Trash {
    special_use = \Trash
  }
}

!include_try conf.d/99-ispconfig-custom-config.conf
